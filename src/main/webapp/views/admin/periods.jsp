<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Đợt đăng ký</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/assets/css/app.css"></head><body><div class="app-shell"><aside class="sidebar"><h2>UTE Topic Hub</h2><nav class="nav flex-column"><a class="nav-link" href="/admin">Tổng quan</a><a class="nav-link" href="/admin/topics">Đề tài</a><a class="nav-link active" href="/admin/periods">Đợt đăng ký</a><a class="nav-link" href="/admin/reports">Báo cáo</a><a class="nav-link" href="/">Trang chủ</a></nav></aside><main class="main"><div class="topbar"><div><div class="eyebrow">Vận hành học kỳ</div><h1 class="h3 mb-1">Đợt đăng ký</h1><p class="muted mb-0">Thiết lập thời gian mở đề tài cho giảng viên và sinh viên.</p></div></div><div class="grid-2"><section class="panel"><h2 class="h5 mb-3">Tạo đợt mới</h2><form action="/admin/periods/save" method="post"><label class="form-label">Tên đợt</label><input class="form-control mb-3" name="name" placeholder="Đợt đăng ký học kỳ 1" required><label class="form-label">Loại</label><select class="form-select mb-3" name="type"><c:forEach items="${registrationTypes}" var="type"><option value="${type}">${type}</option></c:forEach></select><div class="row g-2"><div class="col"><label class="form-label">GV bắt đầu</label><input class="form-control" type="date" name="lecturerStartDate" required></div><div class="col"><label class="form-label">GV kết thúc</label><input class="form-control" type="date" name="lecturerEndDate" required></div></div><div class="row g-2 mt-1"><div class="col"><label class="form-label">SV bắt đầu</label><input class="form-control" type="date" name="studentStartDate" required></div><div class="col"><label class="form-label">SV kết thúc</label><input class="form-control" type="date" name="studentEndDate" required></div></div><button class="btn btn-primary w-100 mt-4">Tạo đợt đăng ký</button></form></section><section class="panel"><h2 class="h5 mb-3">Các đợt hiện có</h2><c:forEach items="${periods}" var="period"><div class="border rounded-3 p-3 mb-2"><div class="d-flex justify-content-between"><strong>${period.name}</strong><span class="badge ${period.active ? 'text-bg-success' : 'text-bg-secondary'}">${period.active ? 'Đang mở' : 'Đã đóng'}</span></div><div class="small muted mt-2">${period.type} · GV: ${period.lecturerStartDate} đến ${period.lecturerEndDate}</div><div class="small muted">SV: ${period.studentStartDate} đến ${period.studentEndDate}</div></div></c:forEach><c:if test="${empty periods}"><p class="muted">Chưa có đợt đăng ký.</p></c:if></section></div></main></div></body></html>
