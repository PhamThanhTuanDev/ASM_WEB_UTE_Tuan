<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Báo cáo</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/assets/css/app.css"></head><body><div class="app-shell"><aside class="sidebar"><h2>UTE Topic Hub</h2><nav class="nav flex-column"><a class="nav-link" href="/admin">Tổng quan</a><a class="nav-link" href="/admin/topics">Đề tài</a><a class="nav-link" href="/admin/periods">Đợt đăng ký</a><a class="nav-link active" href="/admin/reports">Báo cáo</a></nav></aside><main class="main"><div class="topbar"><div><div class="eyebrow">Theo dõi tiến độ</div><h1 class="h3 mb-1">Báo cáo đề tài</h1><p class="muted mb-0">Tổng hợp trạng thái đề tài trong hệ thống.</p></div><button class="btn btn-primary" onclick="window.print()">In báo cáo</button></div><div class="stats"><div class="panel stat"><span class="muted">Tổng đề tài</span><strong>${topics.size()}</strong></div><div class="panel stat"><span class="muted">Đã duyệt</span><strong><c:set var="approved" value="0"/><c:forEach items="${topics}" var="topic"><c:if test="${topic.status == 'APPROVED'}"><c:set var="approved" value="${approved + 1}"/></c:if></c:forEach>${approved}</strong></div><div class="panel stat"><span class="muted">Đã xuất bản</span><strong><c:set var="published" value="0"/><c:forEach items="${topics}" var="topic"><c:if test="${topic.status == 'PUBLISHED'}"><c:set var="published" value="${published + 1}"/></c:if></c:forEach>${published}</strong></div><div class="panel stat"><span class="muted">Hoàn thành</span><strong><c:set var="completed" value="0"/><c:forEach items="${topics}" var="topic"><c:if test="${topic.status == 'COMPLETED'}"><c:set var="completed" value="${completed + 1}"/></c:if></c:forEach>${completed}</strong></div></div><section class="panel"><h2 class="h5">Chi tiết trạng thái</h2><div class="table-responsive"><table class="table"><thead><tr><th>Tên đề tài</th><th>Khoa</th><th>Giảng viên</th><th>Trạng thái</th></tr></thead><tbody><c:forEach items="${topics}" var="topic"><tr><td>${topic.title}</td><td>${topic.department.name}</td><td>${empty topic.lecturer ? 'Chưa phân công' : topic.lecturer.fullName}</td><td><span class="badge text-bg-primary">${topic.status}</span></td></tr></c:forEach></tbody></table></div></section></main></div></body></html>
