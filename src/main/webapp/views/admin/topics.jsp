<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Quản lý đề tài</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/assets/css/app.css"></head><body>
<div class="app-shell"><aside class="sidebar"><h2>UTE Topic Hub</h2><nav class="nav flex-column"><a class="nav-link" href="/admin">Tổng quan</a><a class="nav-link active" href="/admin/topics">Đề tài</a><a class="nav-link" href="/admin/periods">Đợt đăng ký</a><a class="nav-link" href="/admin/reports">Báo cáo</a><a class="nav-link" href="/">Trang chủ</a></nav></aside>
<main class="main"><div class="topbar"><div><div class="eyebrow">Danh mục học thuật</div><h1 class="h3 mb-1">Quản lý đề tài</h1><p class="muted mb-0">Tạo, xuất bản và phê duyệt đề tài cho sinh viên.</p></div><a href="/logout" class="btn btn-outline-secondary">Đăng xuất</a></div>
<div class="grid-2"><section class="panel"><h2 class="h5 mb-3">Tạo đề tài mới</h2><form action="/admin/topics/save" method="post"><label class="form-label">Tên đề tài</label><input class="form-control mb-3" name="title" required><label class="form-label">Mô tả</label><textarea class="form-control mb-3" name="description" rows="5"></textarea><label class="form-label">Khoa</label><select class="form-select mb-3" name="department" required><option value="">Chọn khoa</option><c:forEach items="${departments}" var="department"><option value="${department.id}">${department.name}</option></c:forEach></select><div class="row g-2"><div class="col"><label class="form-label">Số SV tối đa</label><input class="form-control" type="number" name="maxStudents" value="3" min="1" required></div><div class="col"><label class="form-label">Trạng thái</label><select class="form-select" name="status"><c:forEach items="${statuses}" var="status"><option value="${status}">${status}</option></c:forEach></select></div></div><button class="btn btn-primary w-100 mt-4">Lưu đề tài</button></form></section>
<section class="panel"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Danh sách đề tài</h2><span class="badge text-bg-light">${topics.size()} đề tài</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Đề tài</th><th>Khoa</th><th>Trạng thái</th><th></th></tr></thead><tbody><c:forEach items="${topics}" var="topic"><tr><td><strong>${topic.title}</strong><div class="small muted">Tối đa ${topic.maxStudents} sinh viên</div></td><td>${topic.department.name}</td><td><span class="badge text-bg-primary">${topic.status}</span></td><td><form action="/admin/topics/${topic.id}/status" method="post" class="d-flex gap-1"><select class="form-select form-select-sm" name="status"><c:forEach items="${statuses}" var="status"><option value="${status}" ${status == topic.status ? 'selected' : ''}>${status}</option></c:forEach></select><button class="btn btn-sm btn-outline-primary">Lưu</button></form><form action="/admin/topics/${topic.id}/delete" method="post" class="mt-1"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr></c:forEach><c:if test="${empty topics}"><tr><td colspan="4" class="text-center muted py-4">Chưa có đề tài.</td></tr></c:if></tbody></table></div></section></div></main></div></body></html>
