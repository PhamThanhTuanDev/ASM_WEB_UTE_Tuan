<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Đề tài của giảng viên</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/assets/css/app.css"></head><body><div class="app-shell"><aside class="sidebar"><h2>UTE Topic Hub</h2><nav class="nav flex-column"><a class="nav-link" href="/lecturer">Tổng quan</a><a class="nav-link active" href="/lecturer/topics">Đề tài của tôi</a><a class="nav-link" href="/lecturer/reviews">Phản biện & điểm</a><a class="nav-link" href="/logout">Đăng xuất</a></nav></aside><main class="main"><div class="topbar"><div><div class="eyebrow">Không gian giảng viên</div><h1 class="h3 mb-1">Đề tài</h1><p class="muted mb-0">Theo dõi đề tài hướng dẫn và tiến độ phê duyệt.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#topicHelp">Quy trình</button></div><section class="panel"><div class="table-responsive"><table class="table"><thead><tr><th>Đề tài</th><th>Khoa</th><th>Giới hạn nhóm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${topics}" var="topic"><tr><td><strong>${topic.title}</strong><div class="small muted">${topic.description}</div></td><td>${topic.department.name}</td><td>${topic.maxStudents} SV</td><td><span class="badge text-bg-primary">${topic.status}</span></td><td><a class="btn btn-sm btn-outline-primary" href="/lecturer/reviews">Đánh giá</a></td></tr></c:forEach><c:if test="${empty topics}"><tr><td colspan="5" class="text-center muted py-4">Chưa có đề tài nào.</td></tr></c:if></tbody></table></div></section></main></div><div class="modal fade" id="topicHelp"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Quy trình đề tài</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Đề tài được tạo ở khu vực quản trị, sau đó xuất bản, phân nhóm sinh viên và chấm điểm theo tiến độ.</div></div></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
