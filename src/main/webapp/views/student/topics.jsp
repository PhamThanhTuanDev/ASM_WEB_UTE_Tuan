<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Đăng ký đề tài</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/assets/css/app.css"></head><body><div class="app-shell"><aside class="sidebar"><h2>UTE Topic Hub</h2><nav class="nav flex-column"><a class="nav-link" href="/student">Tổng quan</a><a class="nav-link active" href="/student/topics">Đăng ký đề tài</a><a class="nav-link" href="/student/group">Nhóm của tôi</a><a class="nav-link" href="/logout">Đăng xuất</a></nav></aside><main class="main"><div class="topbar"><div><div class="eyebrow">Không gian sinh viên</div><h1 class="h3 mb-1">Đề tài đang mở</h1><p class="muted mb-0">Chọn đề tài phù hợp với nhóm của bạn.</p></div><a class="btn btn-outline-primary" href="/student/group">Xem nhóm của tôi</a></div><div class="row g-3"><c:forEach items="${topics}" var="topic"><div class="col-md-6 col-xl-4"><article class="panel h-100"><span class="badge text-bg-success mb-3">Đang nhận đăng ký</span><h2 class="h5">${topic.title}</h2><p class="muted small">${topic.description}</p><div class="d-flex justify-content-between border-top pt-3 mt-4 small"><span>${topic.department.name}</span><span>Tối đa ${topic.maxStudents} SV</span></div><button class="btn btn-primary w-100 mt-3" data-bs-toggle="modal" data-bs-target="#registerModal">Đăng ký đề tài</button></article></div></c:forEach><c:if test="${empty topics}"><div class="col-12"><div class="panel text-center muted py-5">Hiện chưa có đề tài được xuất bản.</div></div></c:if></div></main></div><div class="modal fade" id="registerModal"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Đăng ký đề tài</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Bạn cần tham gia hoặc tạo nhóm trước khi gửi đăng ký đề tài.</div><div class="modal-footer"><a href="/student/group" class="btn btn-primary">Quản lý nhóm</a></div></div></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
